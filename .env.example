# ─────────────────────────────────────────────────────────────────────────────
# Keystatic CMS — Production (Vercel) configuration
#
# In local dev these are NOT needed. Keystatic reads/writes files directly.
# On Vercel, set all four of these in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Tell Keystatic to use GitHub as the storage backend (instead of local files)
KEYSTATIC_STORAGE_KIND=github

# GitHub OAuth App credentials
# Create one at: https://github.com/settings/developers → OAuth Apps → New
#   Homepage URL:      https://your-domain.vercel.app
#   Callback URL:      https://your-domain.vercel.app/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Any long random string — used to sign session cookies
# Generate one with: openssl rand -hex 32
KEYSTATIC_SECRET=

# The GitHub repo that holds the site (owner/repo format)
KEYSTATIC_GITHUB_REPO_OWNER=
KEYSTATIC_GITHUB_REPO_NAME=david-site
